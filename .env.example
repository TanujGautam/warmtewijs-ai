# Required for the Claude-powered agent. Without it the app runs the offline rule-based agent.
ANTHROPIC_API_KEY=

# Optional
# Registered energy labels from RVO EP-Online (free key via https://www.ep-online.nl). Without it, labels are estimated from build year.
# EP_ONLINE_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Let the agent verify current subsidy rates on rvo.nl and other official sites (server-side web search; extra cost).
# ENABLE_WEB_SEARCH=1

# Payments for Warmtewijs Plus (Stripe Checkout, one-off €19). Setting this switches payments ON and puts the
# quote checker, landlord letter, VvE proposal and quote request behind Plus. Leave empty to keep everything free.
# Use a test key (sk_test_…) on Preview deployments only; a live key (sk_live_…) on Production.
# STRIPE_SECRET_KEY=
