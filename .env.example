# Required for the Claude-powered agent. Without it the app runs the offline rule-based agent.
ANTHROPIC_API_KEY=

# Optional
# Registered energy labels from RVO EP-Online (free key via https://www.ep-online.nl). Without it, labels are estimated from build year.
# EP_ONLINE_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Let the agent verify current subsidy rates on rvo.nl and other official sites (server-side web search; extra cost).
# ENABLE_WEB_SEARCH=1
